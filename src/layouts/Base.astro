---
import '../styles/site.css';
const { title = 'Rindow', description, canonical, bodyClass, math } = Astro.props;
const pageTitle = title === 'Rindow' ? title : `${title} : Rindow`;
const mathEnabled = math === true || math === 'enable' || math === 'true' || math === 'yes';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || 'Rindow develops PHP frameworks, machine learning tools, and mathematics libraries.'} />
    <link rel="canonical" href={canonical || new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/assets/themes/rindow/img/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/themes/rindow/img/apple-touch-icon-precomposed.png" />
    <title>{pageTitle}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-12321104-4"></script>
    <script is:inline define:vars={{ id: 'UA-12321104-4' }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',id);</script>
    <script async src="https://cse.google.com/cse.js?cx=000482340f7b9f4bc"></script>
    {mathEnabled && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.5/dist/katex.min.css" />}
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <a class="brand" href="/">rindow</a>
      <nav aria-label="Main navigation">
        <a href="/neuralnetworks/index.html">Neural Networks</a>
        <a href="/mathematics/index.html">Mathematics</a>
        <a href="/framework/index.html">Framework</a>
        <a href="/blog/index.html">Blog</a>
        <a href="/about/index.html">About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="footer-logo" href="/">rindow</a>
          <p class="footer-tagline">PHP frameworks, machine learning &amp; mathematics libraries.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/neuralnetworks/index.html">Neural Networks</a>
          <a href="/mathematics/index.html">Mathematics</a>
          <a href="/framework/index.html">Framework</a>
          <a href="/blog/index.html">Blog</a>
          <a href="/about/index.html">About</a>
        </nav>
        <div class="footer-social">
          <a
            class="github-link"
            href="https://github.com/rindow"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Rindow on GitHub"
          >
            <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
      <div class="footer-legal">
        <span>Copyright &copy; Rindow</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span>Released under the <a href="https://github.com/rindow/rindow.github.io/blob/master/LICENSE">BSD 3-Clause License</a></span>
      </div>
    </footer>
  </body>
</html>
