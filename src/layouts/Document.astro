---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import DocNavigator from '../components/DocNavigator.astro';
import navigation from '../data/navigation.json';
const { entry, Content } = Astro.props;
const collection = entry.id.split('/')[0];
const title = entry.data.title || collection;
---
<Base title={title} description={entry.data.meta_description}>
  <div class="docs-shell">
    <Sidebar items={navigation[collection] || []} />
    <article class="prose">
      <DocNavigator entry={entry} position="top" />
      <h1>{title}</h1>
      <Content />
      <DocNavigator entry={entry} position="bottom" />
    </article>
  </div>
</Base>
