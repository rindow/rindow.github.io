---
import { getCollection, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
export async function getStaticPaths() {
  return (await getCollection('posts')).flatMap((entry) => {
    const m = entry.id.match(/(\d{4})-(\d{2})-(\d{2})-(.+)$/);
    return m ? [{ params: { year: m[1], month: m[2], day: m[3], slug: m[4] }, props: { entry } }] : [];
  });
}
const { entry } = Astro.props; const { Content } = await render(entry);
---
<Base title={entry.data.title || 'Blog'}><article class="prose standalone"><h1>{entry.data.title}</h1><Content /></article></Base>
